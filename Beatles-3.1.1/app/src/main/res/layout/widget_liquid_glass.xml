<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_glass_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Vivid Album-Synced Liquid Glass Backdrop -->
    <ImageView
        android:id="@+id/widget_glass_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_liquid_glass_bg"
        android:contentDescription="@null" />

    <!-- Main Interior Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Top Row: Larger Framed Album Art + Bold Song Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/widget_liquid_glass_album_frame"
                android:padding="3dp">

                <ImageView
                    android:id="@+id/widget_glass_album_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_widget_music_placeholder"
                    android:contentDescription="@string/widget_album_art" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/widget_glass_song_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/no_song_playing"
                        android:textColor="#FFFFFF"
                        android:textSize="17.5sp"
                        android:textStyle="bold"
                        android:shadowColor="#CC000000"
                        android:shadowDy="1"
                        android:shadowRadius="7" />

                    <TextView
                        android:id="@+id/widget_glass_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/widget_liquid_glass_badge_bg"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="GLASS"
                        android:textColor="#FFFFFF"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:shadowColor="#AA000000"
                        android:shadowRadius="4" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_glass_artist_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/tap_to_open"
                    android:textColor="#F8FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:shadowColor="#CC000000"
                    android:shadowDy="1"
                    android:shadowRadius="6" />

                <ProgressBar
                    android:id="@+id/widget_glass_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5.5dp"
                    android:layout_marginTop="9dp"
                    android:max="10000"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_liquid_glass_progress" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Row: Larger Controls + Solid White Play/Pause Circle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_glass_like_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_liquid_glass_btn_circle"
                android:padding="10dp"
                android:src="@drawable/ic_widget_heart_outline_nav"
                android:contentDescription="@string/widget_like_button" />

            <ImageView
                android:id="@+id/widget_glass_previous"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/widget_liquid_glass_btn_circle"
                android:padding="11dp"
                android:src="@drawable/ic_widget_skip_previous"
                android:contentDescription="Sebelumnya" />

            <ImageView
                android:id="@+id/widget_glass_play_pause"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/widget_liquid_glass_play_circle"
                android:padding="13dp"
                android:src="@drawable/ic_widget_play_black"
                android:contentDescription="@string/widget_play_pause" />

            <ImageView
                android:id="@+id/widget_glass_next"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/widget_liquid_glass_btn_circle"
                android:padding="11dp"
                android:src="@drawable/ic_widget_skip_next"
                android:contentDescription="Berikutnya" />

            <ImageView
                android:id="@+id/widget_glass_open_app"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_liquid_glass_btn_circle"
                android:padding="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/vortex_icon"
                android:contentDescription="Buka Aplikasi" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
