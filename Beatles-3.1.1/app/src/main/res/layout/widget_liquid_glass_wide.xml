<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_glass_wide_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Vivid Album-Synced 3D Liquid Glass Pill Backdrop -->
    <ImageView
        android:id="@+id/widget_glass_wide_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_liquid_glass_bg"
        android:contentDescription="@null" />

    <!-- Pill Content Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Larger Circular Album Art Disc with Progress Ring -->
        <ImageView
            android:id="@+id/widget_glass_wide_album_art"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_music_placeholder"
            android:contentDescription="@string/widget_album_art" />

        <!-- Song Info + Glass Progress Bar -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_glass_wide_song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/no_song_playing"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDy="1"
                android:shadowRadius="6" />

            <TextView
                android:id="@+id/widget_glass_wide_artist_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tap_to_open"
                android:textColor="#F8FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:shadowColor="#CC000000"
                android:shadowDy="1"
                android:shadowRadius="5" />

            <ProgressBar
                android:id="@+id/widget_glass_wide_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="10000"
                android:progress="0"
                android:progressDrawable="@drawable/widget_liquid_glass_progress" />
        </LinearLayout>

        <!-- Larger Glass Pill Control Buttons + Solid White Play/Pause Circle -->
        <ImageView
            android:id="@+id/widget_glass_wide_like_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_liquid_glass_btn_circle"
            android:padding="8dp"
            android:src="@drawable/ic_widget_heart_outline_nav"
            android:contentDescription="@string/widget_like_button" />

        <ImageView
            android:id="@+id/widget_glass_wide_previous"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_liquid_glass_btn_circle"
            android:padding="8dp"
            android:src="@drawable/ic_widget_skip_previous"
            android:contentDescription="Sebelumnya" />

        <ImageView
            android:id="@+id/widget_glass_wide_play_pause"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/widget_liquid_glass_play_circle"
            android:padding="11dp"
            android:src="@drawable/ic_widget_play_black"
            android:contentDescription="@string/widget_play_pause" />

        <ImageView
            android:id="@+id/widget_glass_wide_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/widget_liquid_glass_btn_circle"
            android:padding="8dp"
            android:src="@drawable/ic_widget_skip_next"
            android:contentDescription="Berikutnya" />

    </LinearLayout>

</RelativeLayout>
